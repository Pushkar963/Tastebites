<!-- ================= HEADER ================= -->
    <div id="header">

        <div id="topBar">
            <div id="section1">
                <div id="branding">
                    <div id="brandLogo"></div>
                    <div id="brandName"><a href="/tastebite">TasteBites</a></div>
                </div>

                <div id="location">
                    <span class="locationIcon"></span>
                    <span class="locationLabel">Deliver to</span>
                    <span class="locationAddress">Baker Street 24</span>
                </div>

                <div id="searchBar">
                    <span class="searchIcon"></span>
                    <input type="text" id="searchInput" placeholder="Craving something? Search dishes or restaurants...">
                </div>
            </div>

            <div id="section2">
                <div id="authButtons">
                    <% if(!currUser) { %>
                    <a href="/tastebite/login" id="loginBtn">Log in</a>
                    <a href="/tastebite/signup" id="signupBtn">Sign up</a>
                    <% } %>
                    <% if(currUser) { %>
                        <form action="/tastebite/logout" method="POST" id="logoutForm">
                            <button type="submit" id="logoutBtn">Log out</button>
                        </form>
                    <% } %>
                </div>
                <div id="cart">
                    <span class="cartIcon"></span>
                    <span class="cartLabel">Cart</span>
                    <span id="cartCount">0</span>
                </div>

            </div>
        </div>

        <!-- Trust strip -->
        <div id="trustStrip">
            <div class="trustItem">
                <span class="trustIcon ratingIcon"></span>
                <span class="trustText">4.8 App Rating</span>
            </div>
            <div class="trustItem">
                <span class="trustIcon ordersIcon"></span>
                <span class="trustText">500K+ Orders Delivered</span>
            </div>
            <div class="trustItem">
                <span class="trustIcon verifiedIcon"></span>
                <span class="trustText">100% Safe &amp; Verified Kitchens</span>
            </div>
            <div class="trustItem">
                <span class="trustIcon deliveryIcon"></span>
                <span class="trustText">Avg. delivery under 30 min</span>
            </div>
        </div>

    </div>