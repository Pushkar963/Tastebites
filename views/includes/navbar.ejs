<!-- ================= HEADER ================= -->
    <div id="header">

        <div id="topBar">
            <div id="section1">
                <div id="branding">
                    <div id="brandLogo">
                        <img src="/assets/images/brandLogo.png" alt="TasteBites logo" class="brandLogoImg">
                    </div>
                    <div id="brandName"><a href="/tastebite">TasteBites</a></div>
                </div>

                <div id="location">
                    <span class="locationIcon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin preview-icon"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                    </span>
                    <span class="locationLabel">Deliver to</span>
                    <span class="locationAddress">Baker Street 24</span>
                </div>

                <div id="searchBar">
                    <span class="searchIcon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search preview-icon"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    </span>
                    <input type="text" id="searchInput" placeholder="Craving something? Search dishes or restaurants...">
                </div>
            </div>

            <div id="section2">
                <div id="authButtons">
                    <% if(typeof currUser === "undefined" || !currUser) { %>
                        <!-- lets check -->
                    <!-- <button id="loginBtn">Log in</button>
                    <button id="signupBtn">Sign up</button> -->
                    <a href="/tastebite/login" id="loginBtn">Log in</a>
                    <a href="/tastebite/signup" id="signupBtn">Sign up</a>
                    <% } else { %>
                    
                        <form action="/tastebite/logout" method="POST" id="logoutForm">
                            <button type="submit" id="logoutBtn">Log out</button>
                        </form>
                    <% } %>
                </div>
                <a href="/tastebite/cart" id="cart">
                    <span class="cartIcon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-cart preview-icon"><path d="m2.05 2.05 1.099-.028a1 1 0 0 1 1.008.815l2.69 14.347A1 1 0 0 0 7.83 18H18"/><path d="M4.563 5h16.435a1 1 0 0 1 .981 1.204l-1.026 6.226A2 2 0 0 1 18.962 14H6.25"/><circle cx="18" cy="20" r="2"/><circle cx="8" cy="20" r="2"/></svg>
                    </span>
                    <span class="cartLabel">Cart</span>
                    <span id="cartCount">0</span>
                </a>


                <div id="mobileHeaderActions">
                    <a href="/tastebite/login" id="accountIconBtn" aria-label="Account">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                    </a>
                    <button id="hamburgerBtn" aria-label="Menu">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
                    </button>
                </div>
            </div>
        </div>

