<div id="confirmOverlay">
    <div id="confirmPanel" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
        <div id="confirmTitle">Are you sure?</div>
        <p id="confirmMessage"></p>

        <div id="confirmWordRow" hidden>
            <label for="confirmWordInput">Type <strong id="confirmWord"></strong> to confirm</label>
            <input type="text" id="confirmWordInput" autocomplete="off">
        </div>

        <div id="confirmActions">
            <button type="button" id="confirmCancel" class="adminBtn">Cancel</button>
            <button type="button" id="confirmOk" class="adminBtn primary">Confirm</button>
        </div>
    </div>
</div>