<% layout("/layouts/boilerplate") %>


<body>

<!-- ================= CONTENT ================= -->
<main id="formContent">

    <a href="/tastebite/restaurants/<%= restaurantId %>" id="backLink">
        &larr; Back to Restaurant
    </a>


    <div id="formHeader">

        <div id="formTitle">
            Edit Food Item
        </div>

        <div id="formSubtitle">
            Update the details of this food item.
        </div>

    </div>


    <form method="POST" action="/tastebite/restaurants/<%= restaurantId %>/foods/<%= foodId %>?_method=PUT" id="foodForm" novalidate>

        <!-- ================= IMAGE ================= -->
        <div class="formGroup">

            <label class="formLabel" for="foodImageInput">
                Dish Image
            </label>

            <div id="imageUploadBox">

                <div id="imageUploadIcon"></div>

                <div id="imageUploadText">
                    Click to upload or drag an image here
                </div>

                <input
                    type="file"
                    id="foodImageInput"
                    accept="image/*"
                    name="menuItem[imageUrl]"
                >

            </div>

        </div>


        <!-- ================= NAME ================= -->
        <div class="formGroup">

            <label class="formLabel" for="foodNameInput">
                Dish Name
            </label>

            <input
                type="text"
                class="formInput"
                id="foodNameInput"
                name="menuItem[name]"
                placeholder="e.g. Margherita Pizza"
                value="<%= food.name %>"
                required
            >
            <span class="fieldError">Please enter dish name.</span>
            <span class="fieldSuccess">Dish name looks good</span>
        </div>


        <!-- ================= CATEGORY ================= -->
        <div class="formGroup">

            <label class="formLabel" for="foodCategoryInput">
                Category
            </label>

            <input
                type="text"
                class="formInput"
                id="foodCategoryInput"
                name="menuItem[category]"
                placeholder="e.g. Pizza, Dessert, Beverage"
                value="<%= food.category %>"
                required
            >
            <span class="fieldError">Please enter category of the dish.</span>
            <span class="fieldSuccess">Yummy! Got variety</span>
        </div>


        <!-- ================= FOOD TYPE ================= -->
        <div class="formGroup">

            <label class="formLabel">
                Food Type
            </label>

            <div id="vegToggleGroup">

                <label class="vegOption">
                    <input
                        type="radio"
                        name="menuItem[foodType]"
                        value="VEG"
                        required
                    >
                    <span class="vegDot"></span>
                    Veg
                </label>


                <label class="vegOption">
                    <input
                        type="radio"
                        name="menuItem[foodType]"
                        value="NON-VEG"
                        required
                    >
                    <span class="nonVegDot"></span>
                    Non-Veg
                </label>


                <label class="vegOption">
                    <input
                        type="radio"
                        name="menuItem[foodType]"
                        value="EGG"
                        required
                    >
                    <span class="eggDot"></span>
                    Egg
                </label>

            </div>
            <span class="fieldError">Please select a food type.</span>
            <span class="fieldSuccess">Food type cannot distinguish your customers</span>
        </div>


        <!-- ================= PRICE ================= -->
        <div class="formGroup">

            <label
                class="formLabel"
                for="foodPriceInput"
            >
                Price
            </label>

            <input
                type="number"
                step="0.01"
                class="formInput"
                id="foodPriceInput"
                name="menuItem[price]"
                placeholder="e.g. 14.00"
                value="<%= food.price %>"
                required
            >
            <span class="fieldError">Please enter price of the dish.</span>
            <span class="fieldSuccess">Reasonable Price</span>

        </div>


        <!-- ================= DESCRIPTION ================= -->
        <div class="formGroup">

            <label
                class="formLabel"
                for="foodDescInput"
            >
                Description
                <span class="optionalTag">(optional)</span>
            </label>

            <textarea
                class="formTextarea"
                id="foodDescInput"
                name="menuItem[description]"
                rows="4"
                placeholder="Ingredients, preparation style, what makes it worth ordering"
                required
            ><%= food.description %></textarea>
            <span class="fieldError">Please enter the description of the dish.</span>
            <span class="fieldSuccess">Description of your dish looks amazing</span>
        </div>


        <!-- ================= PERISHABLE ================= -->
        <div class="formGroup">

            <label id="isPerishableRow">

                <input
                    type="checkbox"
                    id="foodPerishableCheckbox"
                    name="menuItem[isPerishable]"
                    <%= food.isAvailable ? "checked" : "" %>
                >

                <span id="isPerishableLabel">
                    This item is perishable
                    (subject to same-day surplus discounting)
                </span>

            </label>

        </div>


        <!-- ================= DISCOUNTED PRICE ================= -->
        <div class="formGroup">

            <label
                class="formLabel"
                for="foodDiscountPriceInput"
            >
                Discounted Price
                <span class="optionalTag">(optional)</span>
            </label>

            <input
                type="number"
                step="0.01"
                class="formInput"
                id="foodDiscountPriceInput"
                name="menuItem[discountedPrice]"
                placeholder="e.g. 6.50"
                value="<%= food.discountedPrice %>"
            >

        </div>


        <!-- ================= AVAILABILITY ================= -->
        <div class="formGroup">

            <label id="isAvailableRow">

                <input
                    type="checkbox"
                    id="foodAvailableCheckbox"
                    name="menuItem[isAvailable]"
                    <%= food.isAvailable ? "checked" : "" %>
                >

                <span id="isAvailableLabel">
                    Available for order right now
                </span>

            </label>

        </div>


        <!-- ================= ACTIONS ================= -->
        <div id="formActions">

            <div id="cancelFormBtn">
                Cancel
            </div>

            <button
                type="submit"
                id="submitFormBtn"
            >
                Save Changes
            </button>

        </div>

    </form>


    <!-- ================= DANGER ZONE ================= -->
    <div id="dangerZone">

        <div id="dangerZoneTitle">
            Danger Zone
        </div>

        <div id="dangerZoneText">
            Deleting a food item is permanent and cannot be undone.
        </div>

        <form method="POST" action="/tastebite/restaurants/<%= restaurantId %>/foods/<%= foodId %>?_method=DELETE">
            <button
                type="submit"
                id="deleteFoodBtn"
            >
                Delete Food Item
            </button>
        </form>

    </div>

</main>
<script src="/js/validate.js"></script>
</body>

