<% layout("/layouts/boilerplate") %>

<body>

    <div id="cartPageContent">

        <a href="/tastebite" id="backLink">&larr; Back to Home</a>

        <div class="sectionHeader">Your Cart</div>

        <!-- Cart items -->
        <div id="cartPageItems">
            <% if (items && items.length > 0) { %>
            <% for (item of items) { %>
                
            <% if (item.menuItemId) { %>
            <div class="cartPageItem" data-id="<%= item.menuItemId._id %>">
                <div class="cartPageItemImage">
                    <img src="<%= item.menuItemId.imageUrl %>" alt="<%= item.menuItemId.name %>" loading="lazy">
                </div>

                <div class="cartPageItemInfo">
                    <div class="cartPageItemName"><%= item.menuItemId.name %></div>
                    <div class="cartPageItemRestaurant"><%= item.menuItemId.restaurantId.name %></div>
                    <div class="cartPageItemPriceRow">
                        <span class="cartPageItemPrice">$<%= (item.menuItemId.discountedPrice ?? item.menuItemId.price).toFixed(2) %></span>
                        <% if (item.menuItemId.discountedPrice !== null) { %>
                            <span class="cartPageItemOldPrice">$<%= item.menuItemId.price.toFixed(2) %></span>
                        <% } %>
                    </div>
                </div>

                <div class="cartPageItemActions">
                    <div class="cartItemQty">
                        <button type="button" class="qtyMinusBtn" aria-label="Decrease quantity">-</button>
                        <span class="qtyValue"><%= item.quantity %></span>
                        <button type="button" class="qtyPlusBtn" aria-label="Increase quantity">+</button>
                    </div>
                    <form method="POST" action="/tastebite/cart/<%= item.menuItemId._id %>?_method=DELETE">
                        <button type="submit" class="cartRemoveBtn">Remove</button>
                    </form>
                </div>
            </div>
            <% } %>
            <% } %>
            <% } else { %>
                <p>Your cart is empty!</p>
            <% } %>


        </div>

        <!-- Empty state -->
        <div id="cartEmptyPageState">
            <div id="cartEmptyPageIcon"></div>
            <div id="cartEmptyPageText">Your cart is empty</div>
            <a href="/tastebite" id="cartEmptyPageBtn">Browse Restaurants</a>
        </div>

        <!-- Order summary -->
        <div id="cartSummaryCard">
            <div class="sectionHeader small">Order Summary</div>

        <div class="summaryRow">
            <span class="summaryLabel">Item Total</span>
            <span class="summaryValue">$<%= summary.itemTotal.toFixed(2) %></span>
        </div>
        <div class="summaryRow">
            <span class="summaryLabel">Delivery Fee</span>
            <span class="summaryValue">$<%= summary.deliveryFee.toFixed(2) %></span>
        </div>
        <% if (summary.savings > 0) { %>
            <div class="summaryRow discount">
                <span class="summaryLabel">Surplus Discount Saved</span>
                <span class="summaryValue">-$<%= summary.savings.toFixed(2) %></span>
            </div>
        <% } %>
        <div class="summaryRow total">
            <span class="summaryLabel">Total</span>
            <span class="summaryValue">$<%= summary.total.toFixed(2) %></span>
        </div>

            <a href="/tastebite/checkout" id="checkoutBtn">Proceed to Checkout</a>
        </div>

    </div>

</body>
