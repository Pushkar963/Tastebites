<% layout("/layouts/boilerplate") %>

<div class="checkoutContainer">
    <h1 class="checkoutTitle">Checkout</h1>

    <div class="checkoutLayout">

        <div class="checkoutMain">
            <section class="checkoutCard checkoutAddressSection">
                <h2 class="checkoutSectionHeading">Delivery Address</h2>
                <div class="checkoutAddressBox">
                    <span class="checkoutAddressIcon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
                    </span>
                    <p class="checkoutAddressText">
                        <%= deliveryAddress.streetAddress %>, <%= deliveryAddress.city %>, <%= deliveryAddress.pincode %>
                        <% if (deliveryAddress.landmark) { %>
                            <br>
                            <%= deliveryAddress.landmark %>
                        <% } %>
                    </p>
                </div>
            </section>

            <section class="checkoutCard checkoutItemsSection">
                <h2 class="checkoutSectionHeading">
                    Your Items
                    <span class="checkoutCount">(<%= checkoutItems.reduce((sum, i) => sum + i.quantity, 0) %>)</span>
                </h2>
                <ul class="checkoutItemList">
                    <% checkoutItems.forEach(item => { %>
                        <li class="checkoutItemRow">
                            <div class="checkoutItemImage">
                                <% if (item.imageUrl) { %>
                                    <img src="<%= item.imageUrl %>" alt="" loading="lazy">
                                <% } %>
                            </div>
                            <div class="checkoutItemInfo">
                                <span class="checkoutItemName"><%= item.name %></span>
                                <span class="checkoutItemMeta">$<%= item.price.toFixed(2) %> each &middot; Qty <%= item.quantity %></span>
                            </div>
                            <span class="checkoutItemPrice">$<%= item.lineTotal.toFixed(2) %></span>
                        </li>
                    <% }) %>
                </ul>
            </section>
        </div>

        <aside class="checkoutCard checkoutSummary">
            <h2 class="checkoutSectionHeading">Order Summary</h2>

            <div class="checkoutTotalRow">
                <span>Item Total</span>
                <span>$<%= itemTotal.toFixed(2) %></span>
            </div>
            <div class="checkoutTotalRow">
                <span>Delivery Fee</span>
                <span>$<%= deliveryFee.toFixed(2) %></span>
            </div>
            <div class="checkoutTotalRow checkoutGrandTotal">
                <span>Total</span>
                <span>$<%= totalAmount.toFixed(2) %></span>
            </div>

            <form class="checkoutPayForm" id="checkoutPayForm" method="POST" action="/tastebite/checkout/pay">
                <button type="submit" class="checkoutPayButton">Pay $<%= totalAmount.toFixed(2) %></button>
            </form>

            <p class="checkoutSecure">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Secure payment powered by Stripe
            </p>
        </aside>

    </div>
</div>

<script>
(function () {
    const form = document.getElementById("checkoutPayForm");
    if (!form) return;
    const btn = form.querySelector(".checkoutPayButton");
    const label = btn.textContent;

    // stop a double click from creating two Stripe sessions
    form.addEventListener("submit", function () {
        btn.disabled = true;
        btn.textContent = "Redirecting to payment…";
    });

    // Back button from the Stripe page can restore this page with the button still disabled
    window.addEventListener("pageshow", function (e) {
        if (e.persisted) {
            btn.disabled = false;
            btn.textContent = label;
        }
    });
})();
</script>